{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "admin.user.restaurant-app-two-sandy.vercel.app"
        }
      ],
      "destination": "/admin/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "admin.restaurant-app-two-sandy.vercel.app" }
      ],
      "destination": "/login/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/home/:path*"
    }
  ]
}
